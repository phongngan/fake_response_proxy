{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fake Response Proxy",
  "version": "0.1.0",
  "identifier": "vn.dainc.fakeresponseproxy",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "python src-tauri/dev-server.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fake Response Proxy",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local HTTP/HTTPS proxy with fake responses",
    "longDescription": "Listens on a local port, intercepts HTTP/HTTPS requests redirected via hosts file, and serves canned/scripted responses. Auto-generates and installs a root CA for HTTPS interception.",
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {}
}
