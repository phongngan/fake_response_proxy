{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hello Tauri",
  "version": "0.1.0",
  "identifier": "test.hello.tauri",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "python src-tauri/dev-server.py"
  },
  "app": {
    "windows": [
      { "title": "Hello Tauri", "width": 800, "height": 600 }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
